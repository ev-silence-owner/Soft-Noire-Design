      {
        "selector": "JSXOpeningElement[name.name='SyncBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:ok|syncing|pending)$/]",
        "message": "<SyncBadge> status must be one of 'ok' | 'syncing' | 'pending'."
