{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "animations-v3.jsx",
              "assets/**",
              "audio/**",
              "components/core/**",
              "components/dashboard/**",
              "components/ritual/**",
              "components/signals/**",
              "components/status/**",
              "prototypes/pulse-tap-surface/**",
              "tweaks-panel.jsx",
              "ui_kits/dashboard/**",
              "ui_kits/patternlens-app/**",
              "ui_kits/patternlens-onboarding/**",
              "ui_kits/swiat-w/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:STIX Two Text|IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: STIX Two Text, IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='BareNumbers'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|key|ref|className|style|children)$/]",
        "message": "<BareNumbers> doesn't accept that prop. Declared props: items."
      },
      {
        "selector": "JSXOpeningElement[name.name='BreathLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:phase|reducedMotion|key|ref|className|style|children)$/]",
        "message": "<BreathLine> doesn't accept that prop. Declared props: phase, reducedMotion."
      },
      {
        "selector": "JSXOpeningElement[name.name='BreathLine'] > JSXAttribute[name.name='phase'] > Literal[value!=/^(?:entry|deepening|silence|return)$/]",
        "message": "<BreathLine> phase must be one of 'entry' | 'deepening' | 'silence' | 'return'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|full|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, full, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:signal|quiet|bare)$/]",
        "message": "<Button> variant must be one of 'signal' | 'quiet' | 'bare'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChoiceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|caption|selected|aspect|onClick|key|ref|className|style|children)$/]",
        "message": "<ChoiceCard> doesn't accept that prop. Declared props: title, meta, caption, selected, aspect, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClusterPulse'] > JSXAttribute > JSXIdentifier[name!=/^(?:clusters|revealed|onReveal|key|ref|className|style|children)$/]",
        "message": "<ClusterPulse> doesn't accept that prop. Declared props: clusters, revealed, onReveal."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConsentRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:flag|label|description|checked|onChange|key|ref|className|style|children)$/]",
        "message": "<ConsentRow> doesn't accept that prop. Declared props: flag, label, description, checked, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='CrisisBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|lines|onDismiss|key|ref|className|style|children)$/]",
        "message": "<CrisisBanner> doesn't accept that prop. Declared props: title, lines, onDismiss."
      },
      {
        "selector": "JSXOpeningElement[name.name='GoldenClock'] > JSXAttribute > JSXIdentifier[name!=/^(?:progress|markers|label|key|ref|className|style|children)$/]",
        "message": "<GoldenClock> doesn't accept that prop. Declared props: progress, markers, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='GoldenRectangle'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|breathing|glow|cycle|key|ref|className|style|children)$/]",
        "message": "<GoldenRectangle> doesn't accept that prop. Declared props: width, breathing, glow, cycle."
      },
      {
        "selector": "JSXOpeningElement[name.name='HealthBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|score|label|size|key|ref|className|style|children)$/]",
        "message": "<HealthBadge> doesn't accept that prop. Declared props: status, score, label, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='HealthBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:adopted|in-progress|not-adopted|deprecated|at-risk)$/]",
        "message": "<HealthBadge> status must be one of 'adopted' | 'in-progress' | 'not-adopted' | 'deprecated' | 'at-risk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HealthBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<HealthBadge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HealthGridCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:pattern|team|coverage|interpretation|status|onClick|key|ref|className|style|children)$/]",
        "message": "<HealthGridCell> doesn't accept that prop. Declared props: pattern, team, coverage, interpretation, status, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='HealthGridCell'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:adopted|in-progress|not-adopted|deprecated|at-risk)$/]",
        "message": "<HealthGridCell> status must be one of 'adopted' | 'in-progress' | 'not-adopted' | 'deprecated' | 'at-risk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InsightCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:observation|option|action|onAction|key|ref|className|style|children)$/]",
        "message": "<InsightCard> doesn't accept that prop. Declared props: observation, option, action, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='IntentSelector'] > JSXAttribute > JSXIdentifier[name!=/^(?:onIntent|locked|key|ref|className|style|children)$/]",
        "message": "<IntentSelector> doesn't accept that prop. Declared props: onIntent, locked."
      },
      {
        "selector": "JSXOpeningElement[name.name='NextWindowHint'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<NextWindowHint> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='ObservationCount'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|label|empty|key|ref|className|style|children)$/]",
        "message": "<ObservationCount> doesn't accept that prop. Declared props: count, label, empty."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:price|period|note|autoRenew|key|ref|className|style|children)$/]",
        "message": "<PriceRow> doesn't accept that prop. Declared props: price, period, note, autoRenew."
      },
      {
        "selector": "JSXOpeningElement[name.name='PulseTapSurface'] > JSXAttribute > JSXIdentifier[name!=/^(?:taps|gateOpen|elapsedMs|mfiState|mfi|capRatio|onTap|onEmergency|key|ref|className|style|children)$/]",
        "message": "<PulseTapSurface> doesn't accept that prop. Declared props: taps, gateOpen, elapsedMs, mfiState, mfi, capRatio, onTap, onEmergency."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuietCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|note|breathing|key|ref|className|style|children)$/]",
        "message": "<QuietCard> doesn't accept that prop. Declared props: label, value, unit, note, breathing."
      },
      {
        "selector": "JSXOpeningElement[name.name='RhythmLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:points|label|key|ref|className|style|children)$/]",
        "message": "<RhythmLine> doesn't accept that prop. Declared props: points, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeedIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:hash|level|ritual|key|ref|className|style|children)$/]",
        "message": "<SeedIndicator> doesn't accept that prop. Declared props: hash, level, ritual."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeedIndicator'] > JSXAttribute[name.name='ritual'] > Literal[value!=/^(?:open|closed)$/]",
        "message": "<SeedIndicator> ritual must be one of 'open' | 'closed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|step|label|suffix|onChange|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: value, min, max, step, label, suffix, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='SummaryRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|compressed|key|ref|className|style|children)$/]",
        "message": "<SummaryRow> doesn't accept that prop. Declared props: items, compressed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|label|description|onChange|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, label, description, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='SyncBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|detail|key|ref|className|style|children)$/]",
        "message": "<SyncBadge> doesn't accept that prop. Declared props: status, detail."
