      {
        "selector": "JSXOpeningElement[name.name='ViewState'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|message|action|onAction|key|ref|className|style|children)$/]",
        "message": "<ViewState> doesn't accept that prop. Declared props: kind, title, message, action, onAction."
